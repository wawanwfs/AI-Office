# WFS Office Gateway (:8787) — containerized
# Produksi = systemd wfs-office (TIDAK disentuh siklus ini).
# Siklus 155 = REHEARSAL: image dibangun & dijalankan di :8788 dengan DB salinan.
FROM python:3.11-slim

WORKDIR /app

# Dependensi runtime gateway (paritas .venv host, tanpa pkg dev):
# fastapi/starlette/pydantic/anyio/httpx/h11/certifi/idna/sniffio/typing_extensions
# + click (uvicorn CLI) + python-dotenv, pyyaml, websockets, greenlet, uvloop, httptools,
# watchfiles, pyee, opentelemetry_api (paritas .venv; jshint/playwright dibiarkan —
# versi host & container dibandingkan pada smoke test).
RUN pip install --no-cache-dir \
    "fastapi==0.143.0" "starlette==1.7.0" "pydantic==2.14.1" "pydantic_core==2.50.1" \
    "anyio==4.15.1" "httpx==0.28.1" "h11==0.16.0" "uvicorn==0.54.0" \
    "click==8.5.0" "python-dotenv==1.2.4" "pyyaml==6.0.3" "websockets==17.2" \
    "greenlet==3.5.6" "uvloop==0.23.0" "httptools==0.9.0" "watchfiles==1.3.0" \
    "annotated_types==0.8.0" "typing_extensions==4.16.0" "idna==3.20" "certifi==2026.7.22" \
    "bcrypt==5.0.0" "annotated_doc==0.0.5" "typing_inspection==0.4.4" \
    "pyee==13.0.1" "opentelemetry_api==1.45.1" "sniffio==1.3.1"

# docker CLI statis (versi host 29.1.3) — endpoint /api/sandboxes & sandbox_exec.py
# menjalankan `docker ps`/`docker exec` via socket host yang di-mount.
ADD https://download.docker.com/linux/static/stable/x86_64/docker-29.1.3.tgz /tmp/docker.tgz
RUN tar -xzf /tmp/docker.tgz -C /tmp && mv /tmp/docker/docker /usr/local/bin/docker \
    && rm -rf /tmp/docker.tgz /tmp/docker \
    && docker --version

# Kode TIDAK di-COPY: di-mount dari host (satu sumber kebenaran dengan produksi).
# Jalankan:
#   docker run -d --name wfs-office-rehearsal --restart unless-stopped \
#     --network host -p 127.0.0.1:8788:8788 \
#     -v ~/wfs-office/server.py:/app/server.py:ro \
#     -v ~/wfs-office/tasks.py:/app/tasks.py:ro \
#     -v ~/wfs-office/orders.py:/app/orders.py:ro \
#     -v ~/wfs-office/sandbox_exec.py:/app/sandbox_exec.py:ro \
#     -v ~/wfs-office/wfs_events.py:/app/wfs_events.py:ro \
#     -v ~/wfs-office/wfs_sh_console.py:/app/wfs_sh_console.py:ro \
#     -v ~/wfs-office/wfs_dashboard_stats.py:/app/wfs_dashboard_stats.py:ro \
#     -v ~/wfs-office/static:/app/static:ro \
#     -v ~/wfs-office/tasks.db:/app/tasks.db \
#     -v ~/wfs-office/orders.db:/app/orders.db \
#     -v ~/wfs-office/config:/app/config \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -v ~/wfs-office/sandboxes:/home/agentuser/wfs-office/sandboxes \
#     -v ~/.hermes/.env:/hermes.env:ro \
#     wfs-office-gw:latest

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && mkdir -p /app/config /app/static

ENV PYTHONUNBUFFERED=1
EXPOSE 8787

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8788/api/health', timeout=4).status==200 else 1)"

CMD ["docker-entrypoint.sh"]
