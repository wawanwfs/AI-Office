# ============================================================
# WFS PROJECT — AI Software House · Environment Configuration
# Copy ke `.env` lalu isi sesuai lingkungan. JANGAN commit `.env`.
# ============================================================

# ---- AI Provider (model utama untuk eksekusi agent) ----
# Format OpenAI-compatible: base URL, key, model.
WFS_AI_BASE=https://api.openai.com/v1
WFS_AI_KEY=
WFS_AI_MODEL=gpt-4o-mini

# Provider alternatif / fallback (opsional)
# WFS_AI_FALLBACK_BASE=
# WFS_AI_FALLBACK_KEY=
# WFS_AI_FALLBACK_MODEL=

# ---- Database / Workspace ----
# Direktori tempat database SQLite & workspace proyek disimpan.
WFS_PROJECTS_DIR=~/wfs-projects
# Path DB SQLite (default: $WFS_PROJECTS_DIR/wfs_software_house.db)
# WFS_DB_PATH=

# ---- Docker Sandbox ----
# Path ke Docker socket (hanya untuk kontrol container).
# Biarkan kosong jika Docker belum dikonfigurasi.
DOCKER_HOST=unix:///var/run/docker.sock
# Prefix nama container proyek (untuk isolasi).
WFS_CONTAINER_PREFIX=wfs-project-

# ---- Server ----
# Gunakan 0.0.0.0 bila ingin diakses lintas jaringan (mis. via Tailscale).
WFS_BIND_HOST=0.0.0.0
WFS_API_PORT=8787
WFS_PROXY_PORT=9503

# ---- Keamanan ----
# Token UI untuk proxy same-origin (di-generate otomatis bila kosong).
# WFS_UI_TOKEN=

# ---- Notifikasi / Tambahan ----
# WFS_TZ=Asia/Jakarta
